# Optional environment variables
APP_ENV=development
DEFAULT_LATITUDE=25.6866
DEFAULT_LONGITUDE=-100.3161
DEFAULT_ALTITUDE_M=540

# Developer-owned Google Maps key. Leave empty to use manual coordinates without the map.
GOOGLE_MAPS_API_KEY=

# Optional credentials for NSRDB PSM3 through pvlib.iotools
NSRDB_API_KEY=
NSRDB_EMAIL=
